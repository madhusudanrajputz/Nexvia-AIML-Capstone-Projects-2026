  "formula_expressions": {
    "amount_log": "LN(1 + GREATEST(h.amount, 0))",
    "origin_balance_log": "LN(1 + GREATEST(h.oldbalanceOrg, 0))",
    "destination_balance_log": "LN(1 + GREATEST(h.oldbalanceDest, 0))",
    "type_cash_in": "CASE WHEN h.type = 'CASH_IN' THEN 1 ELSE 0 END",
    "type_cash_out": "CASE WHEN h.type = 'CASH_OUT' THEN 1 ELSE 0 END",
    "type_debit": "CASE WHEN h.type = 'DEBIT' THEN 1 ELSE 0 END",
    "type_payment": "CASE WHEN h.type = 'PAYMENT' THEN 1 ELSE 0 END",
    "type_transfer": "CASE WHEN h.type = 'TRANSFER' THEN 1 ELSE 0 END",
    "origin_previous_count": "COALESCE(h.origin_previous_count, 0)",
    "origin_previous_total_log": "LN(1 + GREATEST(COALESCE(h.origin_previous_total, 0), 0))",
    "origin_previous_mean_log": "LN(1 + GREATEST(COALESCE(h.origin_previous_mean, 0), 0))",
    "origin_hours_since_previous": "COALESCE(h.origin_hours_since_previous, 0)",
    "destination_previous_count": "COALESCE(h.destination_previous_count, 0)",
    "destination_previous_total_log": "LN(1 + GREATEST(COALESCE(h.destination_previous_total, 0), 0))",
    "destination_previous_mean_log": "LN(1 + GREATEST(COALESCE(h.destination_previous_mean, 0), 0))",
    "destination_hours_since_previous": "COALESCE(h.destination_hours_since_previous, 0)",
    "amount_vs_origin_mean": "CASE WHEN h.origin_previous_mean > 0\n           THEN h.amount / h.origin_previous_mean\n           ELSE 0 END",
    "amount_vs_destination_mean": "CASE WHEN h.destination_previous_mean > 0\n           THEN h.amount / h.destination_previous_mean\n           ELSE 0 END",
    "amount_to_origin_balance": "h.amount / (h.oldbalanceOrg + 1)",
    "amount_to_destination_balance": "h.amount / (h.oldbalanceDest + 1)",
    "origin_has_history": "CASE WHEN h.origin_previous_count > 0 THEN 1 ELSE 0 END",
    "destination_has_history": "CASE WHEN h.destination_previous_count > 0 THEN 1 ELSE 0 END",
    "origin_balance_insufficient": "CASE WHEN h.amount > h.oldbalanceOrg THEN 1 ELSE 0 END"
  },
