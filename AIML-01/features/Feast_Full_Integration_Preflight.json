      "feature_sql_expressions": {
        "amount_log": "LN(1 + GREATEST(amount, 0))",
        "origin_balance_log": "LN(1 + GREATEST(oldbalanceOrg, 0))",
        "destination_balance_log": "LN(1 + GREATEST(oldbalanceDest, 0))",
        "type_cash_in": "CASE WHEN \"type\" = 'CASH_IN' THEN 1 ELSE 0 END",
        "type_cash_out": "CASE WHEN \"type\" = 'CASH_OUT' THEN 1 ELSE 0 END",
        "type_debit": "CASE WHEN \"type\" = 'DEBIT' THEN 1 ELSE 0 END",
        "type_payment": "CASE WHEN \"type\" = 'PAYMENT' THEN 1 ELSE 0 END",
        "type_transfer": "CASE WHEN \"type\" = 'TRANSFER' THEN 1 ELSE 0 END",
        "origin_previous_count": "COALESCE(origin_previous_count, 0)",
        "origin_previous_total_log": "LN(1 + GREATEST(COALESCE(origin_previous_total, 0), 0))",
        "origin_previous_mean_log": "LN(1 + GREATEST(COALESCE(origin_previous_mean, 0), 0))",
        "origin_hours_since_previous": "COALESCE(origin_hours_since_previous, 0)",
        "destination_previous_count": "COALESCE(destination_previous_count, 0)",
        "destination_previous_total_log": "LN(1 + GREATEST(COALESCE(destination_previous_total, 0), 0))",
        "destination_previous_mean_log": "LN(1 + GREATEST(COALESCE(destination_previous_mean, 0), 0))",
        "destination_hours_since_previous": "COALESCE(destination_hours_since_previous, 0)",
        "amount_vs_origin_mean": "COALESCE(amount_vs_origin_mean, 0)",
        "amount_vs_destination_mean": "COALESCE(amount_vs_destination_mean, 0)",
        "amount_to_origin_balance": "COALESCE(amount_to_origin_balance, 0)",
        "amount_to_destination_balance": "COALESCE(amount_to_destination_balance, 0)",
        "origin_has_history": "CASE WHEN origin_previous_count > 0 THEN 1 ELSE 0 END",
        "destination_has_history": "CASE WHEN destination_previous_count > 0 THEN 1 ELSE 0 END",
        "origin_balance_insufficient": "CASE WHEN amount > oldbalanceOrg THEN 1 ELSE 0 END"
      },
